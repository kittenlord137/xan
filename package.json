{
  "name": "clipsqueeze",
  "productName": "xan",
  "version": "1.4.0",
  "description": "Trim and compress videos with ffmpeg",
  "main": "main.js",
  "author": "xan",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/engine.test.js && node test/smoothie.test.js && node test/release.test.js",
    "dist": "electron-builder --win nsis portable --publish never",
    "dist:dir": "electron-builder --dir",
    "test:ui": "electron test/ui-smoke.js",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.clipsqueeze.app",
    "productName": "xan",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "shared/**",
      "renderer/**",
      "package.json",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**",
      "!node_modules/ffmpeg-static/ffmpeg"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "electronLanguages": [
      "en-US"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "kittenlord137",
        "repo": "xan",
        "releaseType": "release"
      }
    ]
  }
}
